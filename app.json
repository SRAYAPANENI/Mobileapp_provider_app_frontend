{
  "expo": {
    "name": "Dodorez Pro",
    "slug": "skofy-service-provider-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "skofyserviceproviderapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby customers.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to show nearby customers.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for voice calls with customers.",
        "NSCameraUsageDescription": "Dodorez Pro needs camera access so you can take your profile photo and document photos.",
        "NSPhotoLibraryUsageDescription": "Dodorez Pro needs photo library access so you can attach documents and skill-proof media.",
        "UIBackgroundModes": [
          "voip",
          "audio",
          "location",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo.png"
      },
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.WAKE_LOCK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9GCq5AcsfOek3gTzAJHe1105SryMJc8Q"
        }
      },
      "package": "com.anonymous.skofyserviceproviderapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Dodorez Pro to use your location to show nearby customers.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#1C1C1E",
            "image": "./assets/images/splash-blank-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dodorez Pro needs camera access so you can take your profile photo and document photos.",
          "photosPermission": "Dodorez Pro needs photo library access so you can attach documents and skill-proof media."
        }
      ],
      "./plugins/with-notification-sounds.js",
      "./plugins/with-real-device-architecture.js",
      "./plugins/with-modular-headers.js",
      "./plugins/with-ios-google-maps.js",
      "./plugins/with-pushkit-voip.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dodorez Pro to use Face ID to unlock the app."
        }
      ],
      "./plugins/with-call-foreground-service.js",
      "./plugins/with-call-ringtone-channel.js",
      "./plugins/with-call-screen.js",
      "@livekit/react-native-expo-plugin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
