{
  "expo": {
    "name": "Dodorez Pro",
    "slug": "skofy-service-provider-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "skofyserviceproviderapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby customers.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to show nearby customers.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for voice calls with customers.",
        "NSCameraUsageDescription": "Skofy needs camera access so you can take your profile photo and document photos.",
        "NSPhotoLibraryUsageDescription": "Skofy needs photo library access so you can attach documents and skill-proof media.",
        "UIBackgroundModes": ["voip", "audio", "location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_PHONE_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "BIND_TELECOM_CONNECTION_SERVICE",
        "WAKE_LOCK"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9GCq5AcsfOek3gTzAJHe1105SryMJc8Q"
        }
      },
      "package": "com.anonymous.skofyserviceproviderapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Skofy Service Provider to use your location to show nearby customers.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#1C1C1E",
            "image": "./assets/images/splash-blank-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Skofy needs camera access so you can take your profile photo and document photos.",
          "photosPermission": "Skofy needs photo library access so you can attach documents and skill-proof media."
        }
      ],
      "./plugins/with-notification-sounds.js",
      "./plugins/with-real-device-architecture.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
